# Copy to .env (gitignored, never commit it) and fill in real values.

# Only needed for eval_harness "deepseek"/"deepseek+defense" llm_names —
# see docs/DEEPSEEK_PIVOT.md. Not needed for scripted-immune/naive-compliant.
DEEPSEEK_API_KEY=

# Postgres connection string. Defaults to local Docker Compose if unset —
# see attack_engine/db.py. Set this to a Neon/Supabase connection string
# when deploying api/main.py somewhere other than this machine.
DATABASE_URL=

# Comma-separated origins the API will accept CORS requests from.
# Defaults to local dev only (http://localhost:3000) if unset. Add the
# deployed Vercel URL when deploying, e.g.
# "http://localhost:3000,https://canary.vercel.app"
CORS_ORIGINS=

# Shared-secret header the dashboard must send once the API is deployed
# publicly — see api/main.py's require_token docstring for exactly what
# this does and doesn't protect against. Leave unset for local dev (the
# check becomes a no-op). Must match dashboard/.env's
# NEXT_PUBLIC_API_TOKEN exactly.
CANARY_API_TOKEN=
