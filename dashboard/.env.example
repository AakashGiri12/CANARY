# Copy to .env.local (gitignored, never commit it) and fill in real values.

# Base URL of the FastAPI backend (api/main.py). Local dev default is
# http://localhost:8001; set to the deployed backend's URL (e.g. a
# Render service) when deploying this dashboard to Vercel.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Shared-secret header sent with every API request once the backend has
# CANARY_API_TOKEN set (see api/main.py's require_token docstring for
# what this does and doesn't protect against). Leave unset for local dev.
# Must match the backend's CANARY_API_TOKEN exactly.
NEXT_PUBLIC_API_TOKEN=
